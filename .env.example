# Optional standalone deployment metadata.
APP_MODE="public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Hosted Supabase configuration (required for production SaaS workflows).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Supabase-backed Studio persistence. Leave blank to remain fully
# browser-only. SUPABASE_SERVICE_ROLE_KEY must never use NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STUDIO_STORAGE_MODE=supabase
# NEXT_PUBLIC_STUDIO_STORAGE_MODE=supabase
# Optional scheduled publishing protection. Not required for ordinary app use.
# CRON_SECRET=
