OPENAI_API_KEY=""
# Select the deployment surface: "public" for the client/public site or "staff" for the staff-only site.
APP_MODE="public"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
CRON_SECRET=""
NEXT_PUBLIC_SITE_URL="https://www.rsa-am.co.za"
# Comma-separated email addresses allowed to view illustrative client-portal demo data.
NEXT_PUBLIC_DEMO_ACCOUNT_EMAILS=""
# Enable manager updates only after approved update publishing and media access are configured.
NEXT_PUBLIC_FEATURE_MANAGER_UPDATES="false"
# Enable the tax-year card only after limits are verified and transaction account types are available.
NEXT_PUBLIC_FEATURE_TAX_YEAR_CARD="false"
# Enable goals only after the client-goals database migration and portal workflow are ready.
NEXT_PUBLIC_FEATURE_GOALS="false"
# Enable profile requests only after staff verification and request handling are ready.
NEXT_PUBLIC_FEATURE_PROFILE_REQUESTS="false"
# Enable online top-ups only after the payment provider and reconciliation process are configured.
NEXT_PUBLIC_FEATURE_ONLINE_TOP_UPS="false"
# Enable eFICA only after identity verification providers and compliance review are configured.
NEXT_PUBLIC_FEATURE_E_FICA="false"
# Enable churn alerts only after the alert rules and authorized admin workflow are configured.
NEXT_PUBLIC_FEATURE_CHURN_ALERTS="false"
# Enable push notifications only after the service worker and notification delivery workflow are ready.
NEXT_PUBLIC_FEATURE_PUSH_NOTIFICATIONS="false"
# Enable onboarding submission only after enquiry consent, rate limiting, and staff handling are confirmed.
NEXT_PUBLIC_FEATURE_ONBOARDING_SUBMIT="false"
